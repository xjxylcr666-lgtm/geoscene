# Copy to .env only when enabling the optional paid model. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Defaults work without this file for manual modelling and analysis.
GEOSCENE_ALLOWED_ORIGINS=http://127.0.0.1:5173
GEOSCENE_REPORT_DIR=outputs/inspection-reports
